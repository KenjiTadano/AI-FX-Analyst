
TWELVE_DATA_API_KEY=

# Task004: Finnhub Market News (personal use). Never use NEXT_PUBLIC_ for secrets.
FINNHUB_API_KEY=
# Economic Calendar requires paid entitlement. No automatic subscription.
FINNHUB_CALENDAR_ENABLED=false
# Set UTC only after confirming the timezone of your calendar feed with the provider.
# Without confirmation, offset-less times stay unverified and are not converted to JST.
FINNHUB_CALENDAR_TIMEZONE=

# Task005: server-side OpenAI Responses API. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# Per-process rolling cost guards; shared quota is needed for multi-instance hosting.
AI_ANALYSIS_HOURLY_LIMIT=20
AI_ANALYSIS_DAILY_LIMIT=100

# Task008: public Supabase project URL and anon/publishable key ONLY.
# Never put a service_role key or sb_secret_ key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Task009: optional server-only Trading Economics calendar entitlement. No subscription required for app use.
TRADING_ECONOMICS_API_KEY=

# Task009: EODHD Economic Events (server-only; keep the real token in .env.local)
EODHD_API_TOKEN=
EODHD_EUR_COUNTRY=
# EODHD documents offset-less timestamps; set UTC only after confirming your entitlement's timezone.
EODHD_CALENDAR_TIMEZONE=
# Task009+: FRED US released macro observations (server-only; keep the real key in .env.local)
FRED_API_KEY=